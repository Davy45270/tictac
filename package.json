{
  "name": "tictac",
  "version": "0.5.0",
  "private": true,
  "description": "Learn to tell time with a friendly touch clock.",
  "license": "MIT",
  "author": "David Sevin",
  "homepage": "https://davy45270.github.io/tictac/",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-size.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts --project=mobile-chromium"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
